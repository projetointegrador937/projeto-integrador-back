# PostgreSQL
POSTGRES_DB=projeto_integrador
POSTGRES_USER=projeto_integrador
POSTGRES_PASSWORD=change-me

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# JWT
JWT_KEY=change-me-use-a-long-random-secret-at-least-32-characters
JWT_ISSUER=ProjetoIntegradorBack
JWT_AUDIENCE=ProjetoIntegradorBack.Client
JWT_ACCESS_TOKEN_MINUTES=30
